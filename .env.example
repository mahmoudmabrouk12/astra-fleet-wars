# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Security & JWT
JWT_SECRET=astra-syndicate-fleet-wars-super-secret-key-2024
JWT_EXPIRES_IN=7d

# Supabase Free-Tier Configuration
# (Can be left empty for Local Mock Mode during development/testing)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Passive Telemetry / Logging
ENABLE_PASSIVE_LOGGING=true
LOG_LEVEL=info
